{
  "expo": {
    "name": "Life Perspective",
    "slug": "time-left",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "time-left",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yacoobali.lifeperspective",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.yacoobali.lifeperspective"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#111111"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yacoobali.lifeperspective"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ProgressWidget",
              "label": "Life Perspective",
              "description": "Shows your life progress percentage",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "DaysLeftWidget",
              "label": "Days Left",
              "description": "Shows estimated full days remaining",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "DotProgressWidget",
              "label": "Life Left",
              "description": "Dot progress bar showing life percentage remaining",
              "minWidth": "180dp",
              "minHeight": "80dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "ArcWidget",
              "label": "Life Arc",
              "description": "Circular arc gauge showing life remaining",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
