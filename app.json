{
  "expo": {
    "name": "Life Perspective",
    "slug": "time-left",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "time-left",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yacoobali.lifeperspective",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.yacoobali.lifeperspective"]
      }
    },
    "android": {
      "icon": "./assets/android_icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android_icon.png",
        "backgroundColor": "#111111"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.yacoobali.lifeperspective"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LifeLeftGridWidget",
              "label": "Life Left Grid",
              "description": "Weeks lived and weeks remaining.",
              "minWidth": "250dp",
              "minHeight": "140dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "LifeArcWidget",
              "label": "Life Arc",
              "description": "Age progress through estimated life.",
              "minWidth": "120dp",
              "minHeight": "120dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "none"
            },
            {
              "name": "TodayLeftWidget",
              "label": "Today Left",
              "description": "Time left before midnight.",
              "minWidth": "115dp",
              "minHeight": "90dp",
              "updatePeriodMillis": 60000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "MilestoneCountdownWidget",
              "label": "Milestones",
              "description": "Countdowns to birthdays and big life dates.",
              "minWidth": "220dp",
              "minHeight": "125dp",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
